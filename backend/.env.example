# ALE 实验工作台 · 后端环境变量示例
# 复制为 backend/.env 后按实际环境填写；该文件已在 .gitignore 中，切勿提交。
# 生成密钥：python -c "import secrets;print(secrets.token_urlsafe(48))"

# 必填：JWT 签名密钥，至少 32 个字符；缺失或过短会导致服务拒绝启动
ALE_JWT_SECRET=

# 部署标识（可留默认）
ALE_ENVIRONMENT=production          # production | testing
ALE_ENVIRONMENT_LABEL=生产环境
ALE_INSTANCE_ID=ale-workbench-production

# 数据库连接：默认账号 ale_app，密码优先取本变量，否则回落到 database/.appcreds
ALE_DB_HOST=127.0.0.1
ALE_DB_PORT=3307
ALE_DB_NAME=ale_workbench
# ALE_DB_PASSWORD=          # 留空则使用 database/.appcreds 中 ale_app 的密码

# 会话 Cookie 是否只在 HTTPS 下发送；本机 http 调试必须为 false，上公网请改 true
ALE_COOKIE_SECURE=false

# 跨域白名单（逗号分隔）。前端与后端同源部署时留空即可
# ALE_ALLOWED_ORIGINS=https://your-domain.example

# 原始文件存储根目录（留空使用项目内 storage/）
# ALE_ORIGINALS_ROOT=H:/ALE_AI/storage
