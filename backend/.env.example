# ALE 实验工作台 · 后端环境变量示例
# 复制为 backend/.env 后按实际环境填写；该文件已在 .gitignore 中，切勿提交。
# 生成密钥：python -c "import secrets;print(secrets.token_urlsafe(48))"

# 必填：JWT 签名密钥，至少 32 个字符；缺失或过短会导致服务拒绝启动
ALE_JWT_SECRET=

# 部署标识（正式机保持 production；测试/开发必须 testing，否则拒绝启动）
ALE_ENVIRONMENT=production          # production | testing
ALE_ENVIRONMENT_LABEL=生产环境
ALE_INSTANCE_ID=ale-workbench-production

# 数据库连接：默认账号 ale_app，密码优先取本变量，否则回落到 database/.appcreds
ALE_DB_HOST=127.0.0.1
ALE_DB_PORT=3307
# 生产库固定 ale_workbench；ALE_ENVIRONMENT=testing 时留空即默认 ale_workbench_test，
# 且库名必须以 _test 结尾，否则启动直接报错（防误写生产库）。正式机建议保持注释。
# ALE_DB_NAME=ale_workbench
# ALE_DB_PASSWORD=          # 留空则使用 database/.appcreds 中 ale_app 的密码

# 会话 Cookie 是否只在 HTTPS 下发送；本机 http 调试必须为 false，上公网请改 true
ALE_COOKIE_SECURE=false

# 跨域白名单（逗号分隔），同时用于登录态刷新/登出时的 Origin 来源校验。
# 前端与后端同源部署时留空即可；走公网域名（Cloudflare Tunnel 等）时**必须**填该域名，
# 否则会话刷新会被 403 拒绝，导致登录约 1 小时后掉线。
# ALE_ALLOWED_ORIGINS=https://ale.example.com

# 原始文件存储根目录（留空：生产 storage/originals，测试库自动 storage-test/originals）
# ALE_ORIGINALS_ROOT=H:/ALE_AI/storage/originals

# —— P0 数据安全（备份，见 docs/P0_数据安全基线.md）——
# 备份根目录必须在项目之外；默认 H:\ALE_Backups
# ALE_BACKUP_ROOT=H:/ALE_Backups
# 备份保留天数（0 = 不自动清理）
# ALE_BACKUP_KEEP_DAYS=30
# MySQL 客户端目录；默认自动使用项目内 mysql-server/bin
# ALE_MYSQL_BIN=H:/ALE_AI/mysql-server/bin
