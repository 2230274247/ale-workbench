<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Project-scoped restore config: a machine-level fallback folder on this host
       (H:\铭\工具\NuGetPackages) no longer exists and breaks restore, so clear it
       and pin the official nuget.org source. Does not modify the user/machine config. -->
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
